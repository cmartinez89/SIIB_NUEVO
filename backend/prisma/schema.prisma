generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int              @id @default(autoincrement())
  nombre    String
  email     String           @unique
  password  String
  activo    Boolean          @default(true)
  establoId Int?
  establo   Establo?         @relation(fields: [establoId], references: [id])
  rolId     Int?
  rol       Rol?             @relation(fields: [rolId], references: [id])
  establos  UsuarioEstablo[]
  equiposTI EquipoTI[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Establo {
  id              Int              @id @default(autoincrement())
  nombre          String
  clave           String           @unique
  activo          Boolean          @default(true)
  usuarios        Usuario[]
  usuariosAlcance UsuarioEstablo[]
  casetaLogs      CasetaLog[]
  valesSalida     ValeSalida[]
  fichasBasculaSab FichaBasculaSab[]
}

// ─── RBAC ───────────────────────────────────────────────────────────────────
// Fase 1: rol-based access. A user has one Rol; a Rol is granted visibility
// on a set of SubModulo (mapped 1:1 to sidebar nav items). esAdmin bypasses
// all checks. Multi-establo data scoping (UsuarioEstablo) is separate from
// menu visibility (RolSubModulo) — a user can see the "Báscula" submodulo
// but only for the establos they're assigned to.

model Rol {
  id        Int            @id @default(autoincrement())
  nombre    String         @unique
  clave     String         @unique
  esAdmin   Boolean        @default(false)
  activo    Boolean        @default(true)
  createdAt DateTime       @default(now())
  usuarios  Usuario[]
  permisos  RolSubModulo[]
}

model Modulo {
  id         Int         @id @default(autoincrement())
  nombre     String
  clave      String      @unique
  icono      String?
  orden      Int         @default(0)
  activo     Boolean     @default(true)
  submodulos SubModulo[]
}

model SubModulo {
  id       Int            @id @default(autoincrement())
  moduloId Int
  nombre   String
  clave    String         @unique
  ruta     String
  orden    Int            @default(0)
  activo   Boolean        @default(true)
  modulo   Modulo         @relation(fields: [moduloId], references: [id])
  roles    RolSubModulo[]
}

model RolSubModulo {
  id            Int       @id @default(autoincrement())
  rolId         Int
  subModuloId   Int
  puedeVer      Boolean   @default(true)
  puedeCrear    Boolean   @default(false)
  puedeEditar   Boolean   @default(false)
  puedeEliminar Boolean   @default(false)
  rol           Rol       @relation(fields: [rolId], references: [id])
  subModulo     SubModulo @relation(fields: [subModuloId], references: [id])

  @@unique([rolId, subModuloId])
}

model UsuarioEstablo {
  id        Int     @id @default(autoincrement())
  usuarioId Int
  establoId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  establo   Establo @relation(fields: [establoId], references: [id])

  @@unique([usuarioId, establoId])
}

model Empleado {
  id              Int           @id @default(autoincrement())
  noEmpleado      Int           @unique
  nombre          String
  apellidoPaterno String
  apellidoMaterno String?
  rfc             String?
  curp            String?
  nss             String?
  activo          Boolean       @default(true)
  puestoId        Int?
  departamentoId  Int?
  establoId       Int?
  salarioDiario   Decimal?      @db.Decimal(10, 2)
  fechaIngreso    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  puesto          Puesto?       @relation(fields: [puestoId], references: [id])
  departamento    Departamento? @relation(fields: [departamentoId], references: [id])
  nominaDetalles  NominaDetalle[]
  evaluacionDepartamentos EvaluacionDepartamentoEmpleado[]
  evaluaciones            EvaluacionEmpleado[]
}

model Puesto {
  id        Int        @id @default(autoincrement())
  nombre    String
  activo    Boolean    @default(true)
  empleados Empleado[]
}

model Departamento {
  id        Int        @id @default(autoincrement())
  nombre    String
  activo    Boolean    @default(true)
  empleados Empleado[]
}

model NominaGrupo {
  id            Int             @id @default(autoincrement())
  folio         String?
  periodo       String?
  fechaInicio   DateTime?
  fechaFin      DateTime?
  fechaPago     DateTime?
  status        String          @default("BORRADOR")
  activo        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  detalles      NominaDetalle[]
}

model NominaDetalle {
  id                Int         @id @default(autoincrement())
  nominaGrupoId     Int
  empleadoId        Int
  totalPercepciones Decimal?    @db.Decimal(10, 2)
  totalRetenciones  Decimal?    @db.Decimal(10, 2)
  pago              Decimal?    @db.Decimal(10, 2)
  createdAt         DateTime    @default(now())
  nominaGrupo       NominaGrupo @relation(fields: [nominaGrupoId], references: [id])
  empleado          Empleado    @relation(fields: [empleadoId], references: [id])
}

model Requisicion {
  id               Int                  @id @default(autoincrement())
  folio            String?
  concepto         String?
  statusId         Int                  @default(1)
  activo           Boolean              @default(true)
  cotizada         Boolean              @default(false)
  aut1Status       String               @default("PENDIENTE")
  aut2Status       String               @default("PENDIENTE")
  aut3Status       String               @default("PENDIENTE")
  proveedorId      Int?
  proveedor        Proveedor?           @relation(fields: [proveedorId], references: [id])
  tokenOrden       String?              @unique
  diasEntrega      Int?
  ubicacionEntrega String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  detalles         RequisicionDetalle[]
}

model RequisicionDetalle {
  id                   Int         @id @default(autoincrement())
  requisicionId        Int
  nombreArticulo       String?
  cantidad             Decimal?    @db.Decimal(10, 2)
  precio               Decimal?    @db.Decimal(10, 2)
  cuentaContable       String?
  cuentaContableNombre String?
  requisicion          Requisicion @relation(fields: [requisicionId], references: [id])
}

model Proveedor {
  id            Int           @id @default(autoincrement())
  nombre        String
  rfc           String?
  activo        Boolean       @default(true)
  requisiciones Requisicion[]
}

// ─── Portal: datos de la empresa para el encabezado del PDF de orden ────────
// Fila única (id=1). Equivalente moderno de C_parametros_configuracion.
model Empresa {
  id              Int     @id @default(1)
  nombre          String  @default("")
  direccion1      String?
  direccion2      String?
  telefono        String?
  rfc             String?
  linkProveedores String?
  logoUrl         String?
}

model Marca {
  id        Int        @id @default(autoincrement())
  nombre    String
  activo    Boolean    @default(true)
  articulos Articulo[]
}

model UnidadMedida {
  id     Int    @id @default(autoincrement())
  nombre String
  clave  String
}

model Articulo {
  id          Int                    @id @default(autoincrement())
  nombre      String
  codigo      String?
  marcaId     Int?
  activo      Boolean                @default(true)
  stockActual Decimal?               @db.Decimal(10, 2)
  stockMinimo Decimal?               @db.Decimal(10, 2)
  marca       Marca?                 @relation(fields: [marcaId], references: [id])
  movimientos InventarioMovimiento[]
}

model InventarioMovimiento {
  id         Int      @id @default(autoincrement())
  articuloId Int
  tipo       String
  cantidad   Decimal  @db.Decimal(10, 2)
  precio     Decimal? @db.Decimal(10, 2)
  concepto   String?
  fecha      DateTime @default(now())
  articulo   Articulo @relation(fields: [articuloId], references: [id])
}

model Dieta {
  id          Int            @id @default(autoincrement())
  nombre      String
  fechaInicio DateTime?
  fechaFin    DateTime?
  activo      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  detalles    DietaDetalle[]
}

model DietaDetalle {
  id           Int      @id @default(autoincrement())
  dietaId      Int
  ingrediente  String?
  kilosBH      Decimal? @db.Decimal(10, 4)
  porcentajeMS Decimal? @db.Decimal(10, 4)
  kilosMS      Decimal? @db.Decimal(10, 4)
  precio       Decimal? @db.Decimal(10, 4)
  costoBH      Decimal? @db.Decimal(10, 4)
  dieta        Dieta    @relation(fields: [dietaId], references: [id])
}

model FacturaForraje {
  id               Int                     @id @default(autoincrement())
  folioFactura     String?
  proveedorNombre  String?
  toneladasTotales Decimal?                @db.Decimal(10, 2)
  importe          Decimal?                @db.Decimal(10, 2)
  tipoCambio       Decimal?                @db.Decimal(10, 4)
  fecha            DateTime                @default(now())
  activo           Boolean                 @default(true)
  detalles         FacturaForrajeDetalle[]
}

model FacturaForrajeDetalle {
  id             Int            @id @default(autoincrement())
  facturaId      Int
  concepto       String?
  toneladasFicha Decimal?       @db.Decimal(10, 2)
  precioFicha    Decimal?       @db.Decimal(10, 4)
  factura        FacturaForraje @relation(fields: [facturaId], references: [id])
}

model Lote {
  id       Int      @id @default(autoincrement())
  nombre   String
  activo   Boolean  @default(true)
  animales Animal[]
}

model Animal {
  id              Int       @id @default(autoincrement())
  arete           String    @unique
  nombre          String?
  sexo            String?
  fechaNacimiento DateTime?
  loteId          Int?
  activo          Boolean   @default(true)
  lote            Lote?     @relation(fields: [loteId], references: [id])
  partos          Parto[]
}

model Parto {
  id          Int       @id @default(autoincrement())
  animalId    Int
  fechaParto  DateTime?
  tipoParto   String?
  observacion String?
  createdAt   DateTime  @default(now())
  animal      Animal    @relation(fields: [animalId], references: [id])
}

model FichaBascula {
  id            Int      @id @default(autoincrement())
  folio         String?
  fecha         DateTime @default(now())
  transportista String?
  placas        String?
  producto      String?
  pesoEntrada   Decimal? @db.Decimal(10, 2)
  pesoSalida    Decimal? @db.Decimal(10, 2)
  pesoNeto      Decimal? @db.Decimal(10, 2)
  status        Int      @default(1)
  activo        Boolean  @default(true)
}

model EnvioLeche {
  id      Int      @id @default(autoincrement())
  fecha   DateTime @default(now())
  cliente String?
  litros  Decimal? @db.Decimal(10, 2)
  precio  Decimal? @db.Decimal(10, 4)
  importe Decimal? @db.Decimal(10, 2)
  status  Int      @default(1)
  activo  Boolean  @default(true)
}

model SolicitudPago {
  id              Int                    @id @default(autoincrement())
  folio           String?
  concepto        String?
  importe         Decimal?               @db.Decimal(10, 2)
  statusId        Int                    @default(1)
  fechaDoc        DateTime?
  proveedorNombre String?
  activo          Boolean                @default(true)
  createdAt       DateTime               @default(now())
  detalles        SolicitudPagoDetalle[]
}

model SolicitudPagoDetalle {
  id             Int           @id @default(autoincrement())
  solicitudId    Int
  concepto       String?
  importe        Decimal?      @db.Decimal(10, 2)
  cuentaContable String?
  solicitud      SolicitudPago @relation(fields: [solicitudId], references: [id])
}

// ─── Casetas: bitácora de entrada/salida + vales de salida ─────────────────
// Simplificación deliberada del original: una fila por visita (no tablas hijas
// separadas por tipo de visita general/báscula/taller) — los campos opcionales
// de báscula/vale se guardan directo en el log. BuscarInformacionFicha's
// integración con la base Firebird externa ("SAB") no se replica aquí — ver
// Fase 3 en el roadmap de migración.
model CasetaLog {
  id                Int       @id @default(autoincrement())
  establoId         Int
  nombreRegistro    String
  tipoEntrada       String
  area              String?
  placas            String?
  asunto            String?
  fechaEntrada      DateTime  @default(now())
  usuarioEntradaId  Int?
  fechaSalida       DateTime?
  tiempoEstanciaSeg Int?
  usuarioSalidaId   Int?
  folioVale         String?
  folioBascula      String?
  pesoSalida        Decimal?  @db.Decimal(10, 2)
  observaciones     String?
  activo            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  establo           Establo   @relation(fields: [establoId], references: [id])
}

model ValeSalida {
  id           Int      @id @default(autoincrement())
  establoId    Int
  folio        String   @unique
  area         String?
  descripcion  String?
  tipoSalida   String?
  proveedor    String?
  nombreActivo String?
  idActivo     String?
  registrado   Boolean  @default(false)
  usuarioId    Int?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  establo      Establo  @relation(fields: [establoId], references: [id])
}

// ─── Tareas: mesa de ayuda interna tipo Kanban ─────────────────────────────
model Ticket {
  id                    Int             @id @default(autoincrement())
  titulo                String
  descripcion           String?
  estado                Int             @default(1) // 1 Abierto 2 Progreso 3 Cerrado 4 Cancelado 5 Espera 6 Reabierto
  prioridad             String          @default("MEDIA")
  categoria             String?
  areaDestino           String?
  usuarioSolicitaId     Int
  usuarioAsignadoId     Int?
  fechaAsignacion       DateTime?
  fechaPrimeraRespuesta DateTime?
  fechaCierre           DateTime?
  usuarioCierraId       Int?
  reaperturas           Int             @default(0)
  activo                Boolean         @default(true)
  createdAt             DateTime        @default(now())
  mensajes              TicketMensaje[]
}

model TicketMensaje {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  usuarioId Int
  mensaje   String
  esInterno Boolean  @default(false)
  fecha     DateTime @default(now())
  activo    Boolean  @default(true)
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
}

// ─── Evaluaciones de desempeño ──────────────────────────────────────────────
// Simplificación deliberada: el original acopla este módulo a Presupuestos
// (C_presupuestos_anios) y a un sistema de autorización paralelo
// ("usuarios masters", acción 2008) que no existen en SIIB_NUEVO. Aquí el
// "año" es un campo plano en EvaluacionPeriodo y la autorización final usa
// el RBAC de Fase 1 (rol esAdmin) en vez de un usuario master.
model EvaluacionDepartamento {
  id        Int                              @id @default(autoincrement())
  nombre    String
  activo    Boolean                          @default(true)
  empleados    EvaluacionDepartamentoEmpleado[]
  rubros       EvaluacionRubro[]
  evaluaciones EvaluacionEmpleado[]
}

model EvaluacionDepartamentoEmpleado {
  id             Int                    @id @default(autoincrement())
  departamentoId Int
  empleadoId     Int
  activo         Boolean                @default(true)
  departamento   EvaluacionDepartamento @relation(fields: [departamentoId], references: [id])
  empleado       Empleado               @relation(fields: [empleadoId], references: [id])

  @@unique([departamentoId, empleadoId])
}

model EvaluacionRubro {
  id             Int                    @id @default(autoincrement())
  departamentoId Int
  nombre         String
  porcentaje     Decimal                @db.Decimal(5, 2)
  activo         Boolean                @default(true)
  departamento   EvaluacionDepartamento @relation(fields: [departamentoId], references: [id])
  conceptos      EvaluacionConcepto[]
}

model EvaluacionConcepto {
  id         Int             @id @default(autoincrement())
  rubroId    Int
  nombre     String
  porcentaje Decimal         @db.Decimal(5, 2)
  activo     Boolean         @default(true)
  rubro      EvaluacionRubro @relation(fields: [rubroId], references: [id])
  capturas   EvaluacionConceptoCapturado[]
}

model EvaluacionPeriodo {
  id                Int                  @id @default(autoincrement())
  descripcion       String
  anio              Int
  abierta           Boolean              @default(true)
  fechaApertura     DateTime             @default(now())
  fechaCierre       DateTime?
  usuarioRegistraId Int?
  activo            Boolean              @default(true)
  evaluaciones      EvaluacionEmpleado[]
}

model EvaluacionEmpleado {
  id                Int                            @id @default(autoincrement())
  periodoId         Int
  empleadoId        Int
  departamentoId    Int
  status            String                         @default("PENDIENTE") // PENDIENTE, CAPTURA, EVALUADA, EXCLUIDA
  calificacionFinal Decimal?                        @db.Decimal(5, 2)
  usuarioCalificaId Int?
  fortalezas        String?
  areaOportunidad   String?
  activo            Boolean                        @default(true)
  periodo           EvaluacionPeriodo              @relation(fields: [periodoId], references: [id])
  empleado          Empleado                       @relation(fields: [empleadoId], references: [id])
  departamento      EvaluacionDepartamento         @relation(fields: [departamentoId], references: [id])
  conceptos         EvaluacionConceptoCapturado[]

  @@unique([periodoId, empleadoId])
}

model EvaluacionConceptoCapturado {
  id                   Int                 @id @default(autoincrement())
  evaluacionEmpleadoId Int
  conceptoId           Int
  calificacion         Decimal             @db.Decimal(5, 2)
  comentarios          String?
  evaluacionEmpleado   EvaluacionEmpleado  @relation(fields: [evaluacionEmpleadoId], references: [id])
  concepto             EvaluacionConcepto  @relation(fields: [conceptoId], references: [id])

  @@unique([evaluacionEmpleadoId, conceptoId])
}

// ─── Catálogos menores ──────────────────────────────────────────────────────
model Clasificacion {
  id     Int     @id @default(autoincrement())
  nombre String
  activo Boolean @default(true)
}

model Centro {
  id     Int     @id @default(autoincrement())
  siglas String  @unique
  nombre String
  activo Boolean @default(true)
}

model EquipoEstablo {
  id            Int     @id @default(autoincrement())
  nombre        String
  clave         String  @unique
  observaciones String?
  activo        Boolean @default(true)
}

// ─── Access: whitelist de dispositivos de campo (tablets báscula/checador) ──
// Simplificación deliberada del original: es un registro/CRUD del
// dispositivo autorizado, sin la lógica de comandos remotos ni heartbeats —
// eso requiere el propio agente en el dispositivo, que no existe todavía.
model DispositivoAcceso {
  id              Int       @id @default(autoincrement())
  nombre          String
  tipo            String // BASCULA, CHECADOR, CASETA
  identificador    String   @unique // MAC address o Android ID
  activo          Boolean   @default(true)
  ultimoAcceso    DateTime?
  createdAt       DateTime  @default(now())
}

// ─── Admin SIIB: inventario de equipo de TI ─────────────────────────────────
// La otra mitad del original (administración del árbol de módulos) ya la
// cubre Modulo/SubModulo de Fase 1 — este modelo cubre solo el inventario.
// No genera PDF de responsiva firmada; el historial de asignación se
// mantiene en los campos usuarioAsignadoId/fechaAsignacion.
model EquipoTI {
  id                Int       @id @default(autoincrement())
  tipo              String // LAPTOP, DESKTOP, IMPRESORA, TELEFONO, OTRO
  marca             String?
  modelo            String?
  numeroSerie       String?   @unique
  estatus           String    @default("DISPONIBLE") // DISPONIBLE, ASIGNADO, BAJA
  usuarioAsignadoId Int?
  usuarioAsignado   Usuario?  @relation(fields: [usuarioAsignadoId], references: [id])
  fechaAsignacion   DateTime?
  activo            Boolean   @default(true)
  createdAt         DateTime  @default(now())
}

// ─── Báscula SAB: segundo canal de pesaje, independiente de FichaBascula ────
// Fase 3 — captura manual del peso en vez de lectura de puerto serie. El
// original lee el peso directo de la báscula física por puerto serie
// (GetPortsNames/ObtenerPesoBascula); replicarlo requiere Web Serial API (a
// petición del usuario, disponible solo en Chrome/Edge, requiere HTTPS) o un
// agente local instalado en la PC de la báscula — ninguno se puede probar
// sin el hardware real, así que esta versión deja el flujo de negocio
// (primera pesada → segunda pesada → cierre, con edición justificada)
// funcional con el peso tecleado, y el punto de integración del puerto
// serie queda marcado explícitamente abajo para cuando haya hardware.
model FichaBasculaSab {
  id                 Int       @id @default(autoincrement())
  folio              String    @unique
  establoId          Int
  transportista       String?
  placas             String?
  proveedor          String?
  producto           String?
  pesoEntrada        Decimal?  @db.Decimal(10, 2)
  fechaEntrada       DateTime?
  usuarioEntradaId   Int?
  pesoSalida         Decimal?  @db.Decimal(10, 2)
  fechaSalida        DateTime?
  usuarioSalidaId    Int?
  pesoNeto           Decimal?  @db.Decimal(10, 2)
  estatus            String    @default("ABIERTA") // ABIERTA, CERRADA
  observacionEdicion String?
  activo             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  establo            Establo   @relation(fields: [establoId], references: [id])
}
